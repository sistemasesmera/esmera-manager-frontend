# Habilitar el sistema de reescritura de URLs
RewriteEngine On

# Base de reescritura
RewriteBase /

# Si el archivo o directorio solicitado existe, se sirve normalmente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Si no existe, redirigir todo a index.html
RewriteRule ^ index.html [L]
